ANTHROPIC_API_KEY=
# Optional second provider. With only this key set, the default model becomes gemini-3-flash-preview.
GEMINI_API_KEY=
# Optional per-purpose model overrides (default: claude-opus-5-5). Any gemini-* name routes to Gemini,
# so EXTRACT_MODEL=gemini-3-flash-preview with ANSWER_MODEL=claude-opus-5-5 mixes providers.
MODEL=
EXTRACT_MODEL=
CLASSIFY_MODEL=
ANSWER_MODEL=
# SQLite file (default data/memory.db)
DB_PATH=
